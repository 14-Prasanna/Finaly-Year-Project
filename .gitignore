# ==========================================
# CyberShield Project .gitignore
# ==========================================

# ------------------------------------------
# Python / Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/env/
env/
venv/
ENV/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Secrets & Environment Variables
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite3
backend/users.db

# Logs
logs/
*.log
backend/logs/
backend/app.log
backend/errors.log

# ML Models (Optional depending on size, usually tracked via Git LFS, but ignored here if large)
# Un-comment the next line if you don't want to track the trained models in Git
# backend/models/*.pkl
# backend/models/*.json
# backend/models/*.joblib

# Test Reports (Allure & pytest-html)
backend/allure-results/
backend/allure-report/
backend/reports/

# ------------------------------------------
# Node / Frontend
# ------------------------------------------
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/coverage/
frontend/.next/
frontend/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# OS / IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
